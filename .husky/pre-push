#!/usr/bin/env sh
# Husky pre-push hook — final safety net before pushing to remote.
# Currently enforces:
#   1. Secret/PAT scan on the diff being pushed
# Future (once tsc cleanups land): re-enable `tsc --noEmit` here.
# Bypass with: git push --no-verify
echo "▶ pre-push: running guardrail checks…"

# Read the ref updates being pushed (from stdin)
while read -r LOCAL_REF LOCAL_SHA REMOTE_SHA REMOTE_REF; do
  echo "  → scanning ${REMOTE_REF} (${LOCAL_SHA}..${REMOTE_SHA})…"

  # GitHub PATs (ghp_), fine-grained PATs (github_pat_), AWS keys (AKIA), OpenAI keys (sk-)
  DIFF_CONTENT=$(git log "${REMOTE_SHA}..${LOCAL_SHA}" --patch 2>/dev/null || true)

  if echo "${DIFF_CONTENT}" | grep -qE "(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,})"; then
    echo "✗ pre-push: Detected a GitHub PAT, AWS key, or API token in the pushed commits."
    echo "  Refusing push. Rotate the leaked secret and amend the commit."
    echo "  If this is a false positive, use: git push --no-verify"
    exit 1
  fi
done

echo "✓ pre-push: secret scan clean."
